rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /invitations/{code} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.status == 'نشط');
      allow list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['status', 'createdAt'])
        && request.resource.data.status == 'نشط';

      allow update: if isAdmin()
        || (signedIn()
          && resource.data.status == 'نشط'
          && request.resource.data.status == 'مستخدم'
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'usedBy', 'usedAt']));

      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'status'])
        && request.resource.data.status == 'active';
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /publicProfiles/{uid} {
      allow get, list: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'online', 'lastActive', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.online is bool;
      allow delete: if false;
    }

    match /calls/{callId} {
      allow read, write: if false;
    }
  }
}